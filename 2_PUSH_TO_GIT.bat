@echo off
title MkDocs Git Sync - VSCI Garden
echo ===================================================
echo [VSCI] Синхронизация изменений с GitHub...
echo ===================================================
cd /d "%~dp0"

echo [1/3] Сборка файлов...
git add .

echo [2/3] Создание слепка изменений...
git commit -m "update: редакция текстов и наполнение фундаментальных работ"

echo [3/3] Отправка на сервера GitHub...
git push origin main

echo ===================================================
echo [УСПЕХ] Ваш сад обновлен в облаке!
echo ===================================================
pause
